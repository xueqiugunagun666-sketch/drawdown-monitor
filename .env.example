# ---- 复制为 .env 后填入真实值，.env 已在 .gitignore 中 ----

# Telegram Bot（Phase 1 单频道）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 注：全站共用口令（ACCESS_TOKEN）已撤销。
# 现在只有个人账号一道门，新人凭邀请码注册：
#   npm run invite -- new 10 "给老王"
# 码只在生成时打印一次，库里只存哈希。

# 管理员账号名（对应 users.name，不是 uuid）。多个用逗号分隔：
#   ADMIN_ACCOUNT=pananiu,retend666
# 删除、改备注、停用/冻结、改报警档位需要管理员。
# 每一项都是整体相等匹配，不做前缀匹配 —— 配 retend 不会把 retend666 一起提权。
# **不设或设错 = 没有人是管理员**，所有删除都会被拒（fail closed）——
# 这是有意的：反过来默认人人可删的话，配置一丢就等于把删除权限敞开。
ADMIN_ACCOUNT=

# SQLite 路径
DATABASE_PATH=./data/monitor.db

# 可选：CoinGecko API key（免费档留空即可）
COINGECKO_API_KEY=

# 可选：GMGN API key（申请：https://gmgn.ai/ai）
# 配了就用它做 OHLCV 回填（实测比 GeckoTerminal 快 20 倍），
# 没配或失败时自动回退 GeckoTerminal。只读接口不需要私钥。
GMGN_API_KEY=

# 可选：本地开发走代理调试境外 API
# HTTPS_PROXY=http://127.0.0.1:7890

# EVM RPC 代理，四条链（ethereum/bsc/base/robinhood）共用，
# 代码会在末尾拼上 chain id，所以这里填到 /rpc 为止、不含 chainId。
# 形如 https://<host>/rpc
EVM_RPC_BASE=

# Solana 钱包持仓扫描 RPC。URL 路径或查询参数可能包含项目凭据，
# 必须只放在 .env；当前生产可填经授权的 XXYY Solana RPC。
SOLANA_RPC_URL=
