# ---- 复制为 .env 后填入真实值，.env 已在 .gitignore 中 ----

# Telegram Bot（Phase 1 单频道）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web UI / API 鉴权：单用户长随机串
ACCESS_TOKEN=

# SQLite 路径
DATABASE_PATH=./data/monitor.db

# 可选：CoinGecko API key（免费档留空即可）
COINGECKO_API_KEY=

# 可选：本地开发走代理调试境外 API
# HTTPS_PROXY=http://127.0.0.1:7890
