[Unit]
Description=Drawdown Monitor Web (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drawdown
Group=drawdown
WorkingDirectory=/opt/drawdown-monitor
EnvironmentFile=/opt/drawdown-monitor/.env
Environment=NODE_ENV=production
Environment=PORT=3000
# 只监听回环，公网访问一律经 Caddy（它负责 HTTPS）
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm run start:prod
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=drawdown-web

StartLimitIntervalSec=300
StartLimitBurst=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/drawdown-monitor/data

[Install]
WantedBy=multi-user.target
