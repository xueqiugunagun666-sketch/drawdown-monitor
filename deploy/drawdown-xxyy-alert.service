[Unit]
Description=Show Tools XXYY Pump and ATH Alert Worker
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=drawdown
Group=drawdown
WorkingDirectory=/opt/drawdown-monitor
EnvironmentFile=/opt/drawdown-monitor/.env
ExecStart=/usr/bin/npm run worker:xxyy-alert
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=drawdown-xxyy-alert

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/drawdown-monitor/data

[Install]
WantedBy=multi-user.target
