# 由 install.sh 把 __DOMAIN__ 替换成真实域名后写入 /etc/caddy/Caddyfile。
#
# 不用 {$ENV} 占位符 —— 官方 Caddy 的 systemd 服务不读 /etc/default/caddy，
# 变量会展开成空串导致配置非法。直接替换最稳。

__DOMAIN__ {
	encode zstd gzip

	# 应用只监听回环，公网流量全部经这里。
	# reverse_proxy 会自动带上 X-Forwarded-For，登录限流按 IP 算就靠它，
	# 不需要再手写 header_up（少一行就少一处能写错的地方）。
	reverse_proxy 127.0.0.1:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}

	# 不写文件日志：Caddy 默认输出到 journald，与 worker / web 两个服务一致，
	# 用 journalctl -u caddy 查看，且 journald 自带轮转。
	# 写文件反而引入属主/权限问题 —— 线上就踩过：安装时 root 建了
	# /var/log/caddy/drawdown.log（600 root:root），caddy 用户打不开，服务起不来。
}
