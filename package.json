{
  "name": "drawdown-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env src/worker/worker.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/sources/*.test.ts src/worker/*.test.ts",
    "check:sources": "tsx --env-file-if-exists=.env scripts/check-sources.ts",
    "check:outliers": "tsx --env-file-if-exists=.env scripts/check-pool-outliers.ts",
    "token:add": "tsx --env-file-if-exists=.env scripts/add-token.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.38.3",
    "lightweight-charts": "^4.2.2",
    "next": "^15.1.3",
    "p-queue": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
