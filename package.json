{
  "name": "drawdown-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "tsx scripts/start.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker/worker.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/db/*.test.ts src/sources/*.test.ts src/worker/*.test.ts src/app/wallet/*.test.ts src/app/wallet/login/*.test.ts 'src/app/api/**/*.test.ts'",
    "check:sources": "tsx --env-file-if-exists=.env scripts/check-sources.ts",
    "check:outliers": "tsx --env-file-if-exists=.env scripts/check-pool-outliers.ts",
    "token:add": "tsx --env-file-if-exists=.env scripts/add-token.ts",
    "start:prod": "next start",
    "check:telegram": "tsx --env-file-if-exists=.env scripts/check-telegram.ts",
    "test:alerts": "tsx --env-file-if-exists=.env scripts/send-test-alerts.ts",
    "repair": "tsx --env-file-if-exists=.env scripts/repair-token.ts",
    "bench": "tsx --env-file-if-exists=.env scripts/bench-engine.ts",
    "backup:pull": "bash scripts/pull-backup.sh",
    "check:rpc": "tsx --env-file-if-exists=.env scripts/check-evm-rpc.ts",
    "check:solana-rpc": "tsx --env-file-if-exists=.env scripts/check-solana-rpc.ts",
    "bench:pump": "tsx --env-file-if-exists=.env scripts/bench-pump.ts",
    "purge:backfill": "tsx --env-file-if-exists=.env scripts/purge-bad-backfill.ts",
    "backfill:owner": "tsx --env-file-if-exists=.env scripts/backfill-owner.ts",
    "audit": "tsx --env-file-if-exists=.env scripts/audit.ts",
    "invite": "tsx --env-file-if-exists=.env scripts/invite.ts",
    "trash:resync": "tsx --env-file-if-exists=.env scripts/trash-resync.ts",
    "purge:mispriced": "tsx --env-file-if-exists=.env scripts/purge-mispriced-candles.ts",
    "ath:backfill": "tsx --env-file-if-exists=.env scripts/ath-backfill.ts",
    "xxyy:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap-xxyy-alerts.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.38.3",
    "lightweight-charts": "^4.2.2",
    "next": "^15.1.3",
    "p-queue": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
